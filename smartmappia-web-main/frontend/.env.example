# ==========================================================
# Frontend (Vite) environment. Copy to ".env" and fill in.
# Only VITE_* vars are exposed to the browser — never put the
# Supabase SERVICE ROLE key here (that lives in the backend only).
# ==========================================================

# Base URL of the Smart Mappia backend API.
VITE_API_BASE=http://localhost:4000

# Supabase project (ANON/public key only) — used for Realtime live updates
# and for uploading payment proofs via signed URLs.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# --- Browser map renderer (Google Maps or Mapbox) ---
# Accepted values: google | mapbox. Defaults to google when omitted. Vite embeds
# this choice at build time, so changing it requires a new frontend build.
VITE_MAP_PROVIDER=google

# Required only when VITE_MAP_PROVIDER=google. Browser key for the Maps JavaScript
# API. Restrict it by HTTP referrer
# to: smartmappia.com, www.smartmappia.com, http://localhost:*, https://localhost/*
# (the Capacitor ANDROID webview origin) AND capacitor://localhost/* (the iOS one).
# Without the matching entry that platform's map renders blank. If the console
# refuses the capacitor:// scheme, the fallback is a SECOND key restricted by iOS
# bundle id (com.smartmappia) instead of by referrer — do not widen this one.
# API-restrict it to "Maps JavaScript API" only. This key is public by design;
# routing/places call the BACKEND proxy with a separate SERVER key, never this one.
VITE_GOOGLE_MAPS_BROWSER_KEY=
# Required in Google mode. Vector Map ID (Google Cloud > Map Management). AdvancedMarkerElement
# and the branded map need a Map ID; without it markers do not render.
VITE_GOOGLE_MAP_ID=

# Required only when VITE_MAP_PROVIDER=mapbox. This must be a PUBLIC Mapbox token
# (normally starts with "pk."), restricted to the website origins where practical.
# Never put a secret Mapbox token in a VITE_ variable: every VITE_ value is shipped
# to the browser. The style may be a Mapbox core style or a Mapbox Studio style URL.
VITE_MAPBOX_ACCESS_TOKEN=
VITE_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12

# (Retired) Old self-hosted map stack — no longer used. Routing still goes through
# the backend Google Routes proxy (/api/route), regardless of the browser renderer.
# VITE_OSRM_BASE=
# VITE_MAP_STYLE_URL=

# Tap Payments. NOTE: there is no longer a VITE_TAP_ENABLED flag — whether
# card payment is offered is decided by the BACKEND (it sets cardAvailable on
# the payment-info response from TAP_SECRET_KEY), so the two halves can never
# disagree. While the backend has no key, the card option shows "coming soon"
# and manual STC Pay is used.
#
# The publishable key is only needed for the Apple Pay Web SDK. It is public
# by design and safe to ship in the bundle; the secret key must never be here.
# VITE_TAP_PUBLIC_KEY=
