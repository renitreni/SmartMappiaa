# ==========================================================
# Frontend (Vite) environment. Copy to ".env" and fill in.
# Only VITE_* vars are exposed to the browser — never put the
# Supabase SERVICE ROLE key here (that lives in the backend only).
# ==========================================================

# Base URL of the Smart Mappia backend API.
VITE_API_BASE=http://localhost:4000

# Supabase project (ANON/public key only) — used for Realtime live updates
# and for uploading payment proofs via signed URLs.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# --- Google Maps Platform (maps + routing + places) ---
# REQUIRED. Browser key for the Maps JavaScript API. Restrict it by HTTP referrer
# to: smartmappia.com, www.smartmappia.com, http://localhost:* AND https://localhost/*
# (the Capacitor Android webview origin — without it the APK map renders blank).
# API-restrict it to "Maps JavaScript API" only. This key is public by design;
# routing/places call the BACKEND proxy with a separate SERVER key, never this one.
VITE_GOOGLE_MAPS_BROWSER_KEY=
# REQUIRED. Vector Map ID (Google Cloud > Map Management). AdvancedMarkerElement
# and the branded map need a Map ID; without it markers do not render.
VITE_GOOGLE_MAP_ID=

# (Retired) Old self-hosted map stack — no longer used. Routing now goes through
# the backend Google Routes proxy (/api/route); tiles come from Google's SDK.
# VITE_OSRM_BASE=
# VITE_MAP_STYLE_URL=

# Tap Payments. NOTE: there is no longer a VITE_TAP_ENABLED flag — whether
# card payment is offered is decided by the BACKEND (it sets cardAvailable on
# the payment-info response from TAP_SECRET_KEY), so the two halves can never
# disagree. While the backend has no key, the card option shows "coming soon"
# and manual STC Pay is used.
#
# The publishable key is only needed for the Apple Pay Web SDK. It is public
# by design and safe to ship in the bundle; the secret key must never be here.
# VITE_TAP_PUBLIC_KEY=
