# ==========================================================
# Frontend (Vite) environment. Copy to ".env" and fill in.
# Only VITE_* vars are exposed to the browser — never put the
# Supabase SERVICE ROLE key here (that lives in the backend only).
# ==========================================================

# Base URL of the Smart Mappia backend API.
VITE_API_BASE=http://localhost:4000

# Supabase project (ANON/public key only) — used for Realtime live updates
# and for uploading payment proofs via signed URLs.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Routing (OSRM). OPTIONAL — leave UNSET and the app routes through the backend
# OSRM proxy (VITE_API_BASE + /api/osrm), which forwards to the self-hosted OSRM
# on the VPS (127.0.0.1:5000). That default is what makes the tracking lines
# follow real streets. Override only to point at another routing host, e.g. the
# public demo in local dev: https://router.project-osrm.org/route/v1/driving
VITE_OSRM_BASE=

# Vector map style for the ride maps (MapLibre GL). OPTIONAL — leave UNSET to
# use the free OpenFreeMap "positron" style (no key, no quota). To self-host
# the tiles on the VPS later (Planetiler KSA .pmtiles + Nginx), point this at
# the hosted style JSON, e.g. https://smartmappia.com/maps/assets/style.json —
# the pmtiles:// protocol is already registered in the app.
VITE_MAP_STYLE_URL=

# Tap Payments online checkout. Leave UNSET/false until the Tap merchant API +
# backend /api/payments/:code/tap-charge endpoint are live. While off, the
# "Pay online" button shows a "coming soon" note and manual STC Pay is used.
VITE_TAP_ENABLED=
