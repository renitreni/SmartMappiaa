# ==========================================================
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env. NEVER put any of these in the frontend.
#
# This file lists EVERY variable the backend reads, in the order lib/config.js
# reads them, with the code default shown in the comment. Keys are left EMPTY
# on purpose: an example file with a plausible value in it is how a wrong value
# reaches production unnoticed. Anything commented out is optional and falls
# back to the documented default.
#
# lib/config.js is the ONLY module that reads process.env for application
# config. The exceptions, all deliberate, are noted below where they occur.
# ==========================================================

# --- PostgreSQL (standalone app database) ---
# Docker Compose derives this from POSTGRES_* values in the project-root .env.
# For local non-Docker development, set a direct PostgreSQL connection URL.
DATABASE_URL=postgres://smartmappia:change-me@localhost:5432/smartmappia
# Generate a random secret with `openssl rand -base64 32`.
APP_SIGNING_KEY=
# DATABASE_POOL_MAX=20
# DATABASE_IDLE_TIMEOUT_MS=30000
# DATABASE_CONNECTION_TIMEOUT_MS=5000

# --- Outbound email (required for app-owned password reset delivery) ---
SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- Server ---
# PORT is read by server.js. Default 4000.
# PORT=
# CORS allow-list, comma-separated origins. EMPTY MEANS EVERY BROWSER ORIGIN IS
# ALLOWED — the process logs a loud warning and starts anyway. Must be set
# before launch. Requests with no Origin header (native app WebView, curl,
# server-to-server) are always allowed regardless.
#
# Include BOTH Capacitor WebView origins: https://localhost for the Android
# app and capacitor://localhost for the iOS app. They differ — listing only
# one leaves that platform unable to reach the API at all.
# ORDER IS IRRELEVANT provided PUBLIC_WEB_URL below is set; it is only a
# fallback for that variable.
#   CORS_ORIGINS=https://smartmappia.com,https://www.smartmappia.com,https://localhost,capacitor://localhost
CORS_ORIGINS=
# The platform's operating timezone. Merchant opening hours are stored as
# wall-clock times and evaluated against this. Saudi has no DST.
# Default: Asia/Riyadh
# PLATFORM_TIMEZONE=

# --- Payments: manual STC Pay ---
# When true, uploading a proof AUTO-VERIFIES the booking. TESTING ONLY.
# This MUST be false in production; the boot log warns when it is not.
# Default: false
AUTO_VERIFY_STCPAY_TEST_MODE=
# LEGACY. Read into config.paymentMode and used by nothing. Kept only so an
# existing value in a deployed .env stays harmless. Which methods are actually
# offered is derived: STC Pay is always on, card follows TAP_SECRET_KEY.
# PAYMENT_MODE=

# --- STC Pay recipient details shown to the passenger ---
SMART_MAPPIA_STCPAY_NUMBER=
# Default: Smart Mappia
# SMART_MAPPIA_STCPAY_NAME=

# --- Payment proof storage (S3-compatible object storage, PRIVATE bucket) ---
# MinIO in Docker Compose; any S3-compatible provider in production. The
# bucket is created by `npm run setup:buckets`. Defaults are used if unset.
# PAYMENT_PROOF_BUCKET=          # default: payment-proofs
# PAYMENT_PROOF_UPLOAD_TTL=      # default: 900     (seconds)
# PAYMENT_PROOF_DOWNLOAD_TTL=    # default: 3600    (seconds)
# PAYMENT_PROOF_MAX_BYTES=       # default: 10485760 (10 MB)

# --- Merchant images: logos + menu/product photos (PUBLIC bucket) ---
# Public because they are rendered with a plain <img src> on the storefront.
# MERCHANT_IMAGES_BUCKET=        # default: merchant-images
# MERCHANT_IMAGES_UPLOAD_TTL=    # default: 900
# MERCHANT_IMAGES_MAX_BYTES=     # default: 5242880 (5 MB)

# --- User avatars (PUBLIC bucket, created lazily by the backend) ---
# AVATARS_BUCKET=                # default: avatars
# AVATARS_UPLOAD_TTL=            # default: 900
# AVATARS_MAX_BYTES=             # default: 5242880 (5 MB)

# --- Driver KYC documents (PRIVATE bucket) ---
# DRIVER_DOCS_BUCKET=            # default: driver-docs
# DRIVER_DOCS_UPLOAD_TTL=        # default: 900
# DRIVER_DOCS_DOWNLOAD_TTL=      # default: 3600
# DRIVER_DOCS_MAX_BYTES=         # default: 10485760 (10 MB)
#
# NOTE ON STORAGE, not a variable: object storage fills up long before the
# database does. Uncompressed KYC photos fill it fast, and when it fills,
# uploads FAIL — an outage for the whole verification flow, not a graceful
# degradation. A database backup does not back up objects; they need their
# own path.

# --- Auth ---
# Accounts whose email is listed here become admins on sign-in/sync
# (comma-separated, case-insensitive). Public signup REFUSES any email on this
# list (403), which is what blocks register-then-auto-promote.
#
# READ AND APPEND. A blind sed that replaces the whole line has already wiped
# existing admins once.
ADMIN_EMAILS=
# RETIRED shared-secret auth. Read into config, used by NO route — every route
# verifies an app-owned session token (APP_SIGNING_KEY). Safe to remove entirely.
# ADMIN_API_KEY=
# DRIVER_API_KEY=

# --- Web Push (PWA notifications) ---
# Generate once with: npx web-push generate-vapid-keys
# Read directly by lib/webPush.js. Keep the private key on the backend only.
# Push is best-effort; the notification inbox row is the durable record.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Google Maps Platform (SERVER key) ---
# REQUIRED. Used by the backend proxies for Routes (/api/route) and Places /
# Geocoding (/api/locations/*). Read directly by lib/googleRoutes.js and
# routes/locations.js.
#
# Restrict it by IP to the VPS and API-restrict it to Routes + Places +
# Geocoding. Keep it server-only — never give it a VITE_ name. Without it,
# ETAs silently degrade to a haversine estimate rather than failing, so the
# symptom is "ETAs look wrong", not an error.
GOOGLE_MAPS_SERVER_KEY=

# ==========================================================
# Money. Every default below is asserted in
# backend/test/money-defaults.test.js — changing one produces a failing test.
# ==========================================================

# --- Ride payout ledger ---
# Commission as a fraction (0.20 = 20%). Manual payment fee is a fixed amount.
# PLATFORM_COMMISSION_RATE=      # default: 0.2
# MANUAL_PAYMENT_FEE=            # default: 0

# --- Driver / rider cash settlement ---
# On a cash job the driver collects the money and owes SmartMappia its share.
# Past this running-owed cap they cannot accept new cash work — rides, food AND
# shop deliveries — until an admin records a settlement.
# Keep DRIVER_CASH_OWED_LIMIT in sync with the profiles.cash_owed_limit column
# default in migration 0022. profiles.cash_owed_limit overrides it per driver.
# DRIVER_CASH_OWED_LIMIT=        # default: 500
# DRIVER_CASH_ALERT_PCT=         # default: 0.8

# --- KSA VAT ---
# Charged ON TOP of the pre-tax amounts on all three services, and snapshotted
# onto every order/booking (migration 0025) — changing the rate here never
# rewrites tax on money already taken. Fraction: 0.15 = 15%.
#
# THE BASE DIFFERS BY VERTICAL. Food and shop tax the goods subtotal ONLY —
# the delivery fee is outside it. Rides tax the whole fare, because the trip
# is the supply and there is no separate delivery line to exclude.
# VAT_RATE=                      # default: 0.15

# --- Recovering card charges Tap never told us about ---
# The webhook is not guaranteed to arrive. Layers: the charge id is written
# before the redirect, the customer's return verifies it, and this sweep
# catches the customer who never comes back. MIN_AGE is a grace period (they
# may still be on the 3DS page); past MAX_AGE a charge is a support question,
# not a sweep. BATCH caps outbound calls to Tap's rate-limited API.
# CHARGE_SWEEP_MS=               # default: 300000 (5 min)
# CHARGE_SWEEP_MIN_AGE_MIN=      # default: 5
# CHARGE_SWEEP_MAX_AGE_MIN=      # default: 120
# CHARGE_SWEEP_BATCH=            # default: 25

# ==========================================================
# Super admin bootstrap (scripts/seed-super-admin.js, migration 0043)
# ==========================================================
# Optional. Sets the password for ferdzsabado@smartmappia.com when
# `npm run seed:super-admin` runs; without it a strong random one is
# generated and printed once. Min 12 characters.
#
# Keep it HERE and not in the script: scripts/ is tracked and pushed to
# GitHub, .env is not. Remove this line again once the account exists —
# the seeder is the only thing that reads it, and a live admin password
# sitting in the server environment is one more place it can leak from.
# SUPER_ADMIN_PASSWORD=

# ==========================================================
# Distance pricing + ETA — SHARED by food, shop and rides
# ==========================================================
# The vertical's flat delivery fee covers the first DELIVERY_FREE_RADIUS_KM,
# then DELIVERY_SURCHARGE_PER_KM applies per extra km.
#
# DELIVERY_MAX_RADIUS_KM IS NO LONGER THE LIVE CAP. Since migration 0043 the
# maximum distance is an admin setting (app_settings.max_distance_km), edited
# in the portal under Settings, and it governs RIDES AS WELL AS deliveries —
# there is one answer on the platform to how far is too far. It ships as
# "no limit". This env var survives only as the fallback used when that row
# or table is missing, i.e. when 0043 has not been applied yet.
#
# The surcharge is platform revenue on every service. On rides it is stored
# OUTSIDE bookings.fare_amount on purpose, because fare_amount is the driver's
# commission base (lib/ledger.js).
# DELIVERY_FREE_RADIUS_KM=       # default: 15
# DELIVERY_SURCHARGE_PER_KM=     # default: 0.25
# DELIVERY_MAX_RADIUS_KM=        # default: 50 (fallback only — see above)

# OUR CUT of a food/shop delivery fee; the driver keeps the rest. 0.1 = we
# take 10%, the driver keeps 90% — including 90% of the distance surcharge,
# since they drove it. Snapshotted per order as orders.driver_fee /
# driver_fee_rate (migration 0041), so changing this NEVER restates a
# delivery already made or a cash balance already owed against it.
#
# Separate from PLATFORM_COMMISSION_RATE (rides, 20%) on purpose: they are
# different deals, and one constant for both would move the wrong one.
# DELIVERY_PLATFORM_SHARE=       # default: 0.1

# Customer-facing ETA. Real driving time comes from Google Routes. DELIVERIES
# are floored at DELIVERY_MIN_ETA_MINUTES to cover the kitchen/packing stage a
# routing API cannot see; rides are never floored. The band is the displayed
# width: 45 + 5 -> "45 - 50 mins".
# DELIVERY_MIN_ETA_MINUTES=      # default: 45
# DELIVERY_ETA_BAND_MINUTES=     # default: 5
# How long a routed ETA is reused before asking Google again. Tracking pages
# poll every 8s, so lowering this multiplies the Routes bill.
# DELIVERY_ETA_CACHE_MS=         # default: 60000

# ==========================================================
# Food Delivery
# ==========================================================
# Business rules. Defaults already match the PRD; override only if the product
# rules change.
# FOOD_MIN_ORDER=                # default: 30
# FOOD_DELIVERY_FEE=             # default: 10   (promo rate, first 3 months)
# The FREE band, not the cut-off — see DELIVERY_MAX_RADIUS_KM above.
# FOOD_RADIUS_KM=                # default: 15
# Per-unit fallback margins, used only when a menu item has no net_price.
# Clamped to the unit price, so an item cheaper than its own flat margin cannot
# charge the merchant more than the line earned.
# FOOD_MARGIN_MEAL=              # default: 5
# FOOD_MARGIN_DRINK=             # default: 3

# Merchant credit line. VESTIGIAL: order acceptance no longer writes
# merchants.credit_used, so these gate nothing today. Left in place because the
# columns and the admin replenish action still exist and still read them.
# MERCHANT_CREDIT_LIMIT=         # default: 300
# CREDIT_ALERT_PCT=              # default: 0.8

# An order still 'pending'/'accepted' this many minutes after checkout means the
# kitchen never tapped "Start preparing": the restaurant, the admins and the
# customer are re-notified every interval, up to MAX times.
# FOOD_PREPARING_REMINDER_MINUTES=   # default: 10
# FOOD_PREPARING_REMINDER_MAX=       # default: 6
# FOOD_PREPARING_REMINDER_SWEEP_MS=  # default: 60000

# ==========================================================
# Ecommerce / "shop"
# ==========================================================
# MASTER SWITCH — defaults to false, and /api/shop plus /api/merchant/shop
# return 503 while it is off. Only set it true once the store portal, the admin
# queue and the rider claim endpoints are all live: stock is reserved at
# checkout, so a half-built vertical can take real money for an order nobody can
# accept and hold inventory with no manual release path.
# SHOP_ENABLED=                  # default: false

# SHOP_MIN_ORDER=                # default: 50
# SHOP_DELIVERY_FEE=             # default: 15
# The FREE band, not the cut-off — see DELIVERY_MAX_RADIUS_KM above.
# SHOP_RADIUS_KM=                # default: 15
# Fallback markup per unit when a product has no net_price. Clamped to the unit
# price, same as the food margins above.
# SHOP_DEFAULT_MARGIN=           # default: 5
# Default "running low" line for new products. Keep in sync with the
# products.low_stock_threshold column default in migration 0026.
# SHOP_LOW_STOCK=                # default: 5

# Stock is reserved at CHECKOUT, before payment, so an unpaid order holds
# inventory — without expiry that is a denial-of-inventory vector. The sweeper
# cancels unpaid orders and releases their stock. Keep both windows comfortably
# longer than the STC Pay manual verification turnaround.
#   ORDER_EXPIRY    covers 'pending'  (cash is NOT exempt: payment_method is a
#                   free client choice at checkout, so exempting it left no
#                   expiry at all)
#   ACCEPTED_EXPIRY covers 'accepted' but unpaid, which the pending window can
#                   never reach. Cash IS exempt here — an accepted cash order is
#                   legitimately unpaid until the rider collects at the door.
# SHOP_ORDER_EXPIRY_MINUTES=     # default: 30
# SHOP_ACCEPTED_EXPIRY_MINUTES=  # default: 180
# SHOP_STALE_SWEEP_MS=           # default: 60000

# ==========================================================
# Dispatch (shared by rides, food and shop)
# ==========================================================
# Nearest online driver gets an exclusive offer for OFFER_SECONDS; on
# decline/timeout it cascades to the next. Drivers count as online when their
# last GPS ping is fresher than DRIVER_FRESH_MINUTES.
# DISPATCH_OFFER_SECONDS=        # default: 30
# DISPATCH_DRIVER_FRESH_MINUTES= # default: 3
# DISPATCH_SWEEP_MS=             # default: 5000
# A rider who accepted but whose GPS goes silent this long (before pickup) is
# treated as disconnected: the job is released and re-offered to the next rider.
# DISPATCH_ABANDON_MINUTES=      # default: 5

# ==========================================================
# Geofence — physical-presence checks on driver status transitions
# ==========================================================
# GEOFENCE_ENABLED is a kill switch if field GPS accuracy causes problems.
# The airport radius is larger because a Pick & Drop pickup point is a whole
# terminal building, and GPS multipath near large structures degrades accuracy
# further; the default radius would false-reject a driver legitimately waiting.
# GEOFENCE_ENABLED=              # default: true
# GEOFENCE_RADIUS_METERS=        # default: 300
# GEOFENCE_AIRPORT_RADIUS_METERS=# default: 800
# How old a fallback driver_locations row may be before it is untrusted.
# GEOFENCE_MAX_FIX_AGE_MINUTES=  # default: 3

# ==========================================================
# Tap Payments — the online card gateway (cards, mada, Apple Pay, saved cards)
# ==========================================================
# TAP_SECRET_KEY IS THE SWITCH. Leave it unset and /api/payments and
# /api/payment-methods are replaced wholesale by a 503 stub, GET
# /api/payments/config becomes unreachable, and the frontend therefore offers
# manual STC Pay and cash only. There is no client-side card flag — the retired
# VITE_TAP_ENABLED was exactly that, and it could contradict this key in either
# direction. Do not reintroduce one.
#
# TAP_PUBLIC_KEY is publishable and safe in a browser; it reaches the frontend
# as VITE_TAP_PUBLIC_KEY and is only needed by the Apple Pay Web SDK.
# TAP_SECRET_KEY=
# TAP_PUBLIC_KEY=
# TAP_MERCHANT_ID=
# TAP_API_BASE=                  # default: https://api.tap.company

# THERE IS NO TAP_WEBHOOK_SECRET, and there never was one that worked. Tap's
# `hashstring` header is an HMAC-SHA256 over a concatenation of NAMED charge
# fields (x_id, x_amount, x_currency, ...) keyed with the SECRET API KEY itself.
# If TAP_WEBHOOK_SECRET is set in a .env somewhere, it does nothing — remove it.
# Because the hash covers named fields rather than raw bytes, no raw-body
# capture is needed and none should be added.

# Apple Pay through Tap's Web SDK. Needs no Apple Developer account and no
# domain-association file, but the SDK must be enabled on the Tap account first.
# TAP_APPLE_PAY_ENABLED=         # default: false

# Charging a saved card WITHOUT a 3DS redirect. Only legal once Tap has
# activated Payment Agreements on the account, and only for cards that have an
# agreement id. Leave it false until that activation is confirmed working — with
# it false, saved cards still work, they just show the bank's 3DS page.
# TAP_ALLOW_NON_3DS_ON_FILE=     # default: false

# How many cards one customer may keep. Tap's list endpoint returns the 10 most
# recent, so staying under that keeps reconciliation single-page.
# TAP_MAX_SAVED_CARDS=           # default: 5

# --- Absolute public URLs (gateway redirect + webhook post URLs) ---
# SET BOTH EXPLICITLY. Neither failure is loud.
#
# PUBLIC_WEB_URL unset falls back to the FIRST entry of CORS_ORIGINS, which
# makes the order of that list silently load-bearing: reorder it and paying
# customers land on the wrong host.
#
# PUBLIC_API_BASE has NO fallback. Unset it resolves to '' and every charge is
# created with a RELATIVE webhook post.url, which Tap cannot call. The charge
# still succeeds and the customer is still debited — the confirmation simply
# never arrives, the order sits at 'awaiting' forever, and nothing logs an error
# because nothing failed. It must be reachable from the public internet; use a
# tunnel when testing card payments locally.
# PUBLIC_WEB_URL=
# PUBLIC_API_BASE=
# Object storage uses the S3-compatible adapter. Compose points it at MinIO;
# production may point to another S3-compatible provider without changing app code.
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
# OBJECT_STORAGE_FORCE_PATH_STYLE=true

# ==========================================================
# Seed scripts (backend/scripts/) — NOT read by the running server
# ==========================================================
# NEVER re-run a seed against production once real accounts exist under these
# identities: it resets passwords and invalidates credentials already handed to
# real people. `npm run seed:admins` generates a strong random password per admin
# and prints it once, so it needs no password variable — and running it twice on
# production locks out the existing named admins.
#
# Any email set here must NOT also appear in ADMIN_EMAILS on production.
# ADMIN_SEED_EMAIL=
# ADMIN_SEED_PASSWORD=
# USER_SEED_EMAIL=
# USER_SEED_PASSWORD=
# DRIVER_SEED_EMAIL=
# DRIVER_SEED_PASSWORD=

# --- Demo / QA scaffolding (backend/scripts/demo/, scripts/_qa_*) ---
# Local only. The _qa_* scripts are gitignored because they carry hardcoded test
# passwords and bypass the real signup path.
# DEMO_FRONTEND_URL=             # default: http://localhost:5173
# SIM_API_BASE=                  # default: http://localhost:$PORT
# QA_SCRATCH=                   # default: . (the current directory)
