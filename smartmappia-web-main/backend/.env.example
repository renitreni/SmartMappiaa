# ==========================================================
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file. NEVER put these in the frontend.
# ==========================================================

# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The SERVICE ROLE key bypasses Row-Level Security. Server only. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Server ---
PORT=4000
# CORS allow-list (comma-separated origins). Leave empty to allow all (dev/pilot).
# Set to the production frontend origin(s) before launch, e.g.
# CORS_ORIGINS=https://smartmappia.com,https://www.smartmappia.com
CORS_ORIGINS=

# --- Payment / testing flags (spec sections 4 and 16) ---
# When true, uploading a proof auto-verifies the booking FOR TESTING ONLY.
# This MUST be false in production.
AUTO_VERIFY_STCPAY_TEST_MODE=true
# stcpay_manual | stcpay_manual_test_auto | moyasar | both
PAYMENT_MODE=stcpay_manual_test_auto

# --- Smart Mappia STC Pay details shown to the passenger (spec section 6) ---
SMART_MAPPIA_STCPAY_NUMBER=05XXXXXXXX
SMART_MAPPIA_STCPAY_NAME=Smart Mappia

# --- Payment proof storage (Supabase Storage) ---
# Create a PRIVATE bucket with this name in the Supabase dashboard.
PAYMENT_PROOF_BUCKET=payment-proofs
# Signed URL lifetimes (seconds) and max upload size (bytes, default 10 MB).
PAYMENT_PROOF_UPLOAD_TTL=900
PAYMENT_PROOF_DOWNLOAD_TTL=3600
PAYMENT_PROOF_MAX_BYTES=10485760

# --- Merchant images: restaurant logos + menu photos (Supabase Storage) ---
# Create a PUBLIC bucket with this name (customer-facing images are served via
# a plain <img src>, so unlike proofs/driver-docs this bucket is public).
# Defaults are used if unset; uncomment to override.
# MERCHANT_IMAGES_BUCKET=merchant-images
# MERCHANT_IMAGES_UPLOAD_TTL=900
# MERCHANT_IMAGES_MAX_BYTES=5242880

# --- Auth (Supabase JWT) ---
# Accounts whose email is listed here automatically become admins on sign-in
# (comma-separated, case-insensitive). Everyone else is a passenger/driver.
# The named admins created by `npm run seed:admins` (Ruth, Nawaf) should be listed here too.
ADMIN_EMAILS=admin123@smartmappia.com,ruth@smartmappia.com,nawaf@smartmappia.com

# --- Web Push (PWA notifications) ---
# Generate once with: npx web-push generate-vapid-keys
# Keep the private key on the backend only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@smartmappia.com

# --- Location search (Nominatim / Overpass proxies) ---
# Nominatim's usage policy REQUIRES an identifying User-Agent with a contact.
# Set a real monitored inbox in production or lookups risk external bans
# (which surface as 502 "temporarily unavailable").
LOCATION_API_USER_AGENT=SmartMappia/1.0 (contact: support@smartmappia.com)

# --- Default admin seed (used by `npm run seed:admin`) ---
# TEST CREDENTIALS — change these before production.
ADMIN_SEED_EMAIL=admin123@smartmappia.com
ADMIN_SEED_PASSWORD=admin123
# Named admins (Ruth, Nawaf) are created by `npm run seed:admins`, which generates
# a strong random password for each and prints it once — no password env needed.

# (Deprecated) old shared-secret keys — no longer used now that routes
# verify Supabase JWTs. Safe to remove.
# ADMIN_API_KEY=
# DRIVER_API_KEY=

# --- Ledger / payout math (spec section 12) ---
# Commission as a fraction (0.20 = 20%). Manual payment fee is a fixed amount.
PLATFORM_COMMISSION_RATE=0.20
MANUAL_PAYMENT_FEE=0

# ==========================================================
# Food Delivery (docs/food-delivery/)
# ==========================================================

# --- Business rules (defaults already match the PRD; override only if the
#     product rules change) ---
# FOOD_MIN_ORDER=30
# FOOD_DELIVERY_FEE=10
# FOOD_RADIUS_KM=15
# FOOD_MARGIN_MEAL=5
# FOOD_MARGIN_DRINK=3
# MERCHANT_CREDIT_LIMIT=300
# CREDIT_ALERT_PCT=0.8

# --- Grab-style dispatch (nearest online driver, exclusive offer, cascade) ---
# DISPATCH_OFFER_SECONDS=30
# DISPATCH_DRIVER_FRESH_MINUTES=3
# DISPATCH_SWEEP_MS=5000
# A rider who accepted but whose GPS goes silent this long (before pickup) is
# treated as disconnected: the order is released + re-offered to the next rider.
# DISPATCH_ABANDON_MINUTES=5

# --- Tap Payments — PLACEHOLDER (not integrated yet). Leave these unset:
#     every Tap endpoint answers "not configured" and STC Pay manual stays
#     the live payment path. Fill in only after Tap onboarding + sandbox
#     verification of the webhook signature.
# TAP_SECRET_KEY=
# TAP_PUBLIC_KEY=
# TAP_WEBHOOK_SECRET=
# TAP_MERCHANT_ID=
