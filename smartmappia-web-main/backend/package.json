{
  "name": "smart-mappia-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Smart Mappia — Airport Pick & Drop backend (Express + Supabase, plain JavaScript)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "seed:admin": "node scripts/seed-admin.js",
    "seed:admins": "node scripts/seed-admins.js",
    "seed:super-admin": "node scripts/seed-super-admin.js",
    "set:password": "node scripts/set-password.js",
    "seed:user": "node scripts/seed-user.js",
    "seed:driver": "node scripts/seed-driver.js",
    "seed:accounts": "node scripts/seed-admin.js && node scripts/seed-user.js && node scripts/seed-driver.js",
    "seed:drink-sizes": "node scripts/seed-drink-sizes.js",
    "seed:aling-marias": "node scripts/seed-aling-marias.js",
    "check:migrations": "node scripts/check-migrations.js",
    "check:shop": "node scripts/check-shop.js",
    "check:tap": "node scripts/check-tap.js",
    "check:hours": "node scripts/check-store-hours.js",
    "setup:buckets": "node scripts/setup-buckets.js",
    "reset:orders": "node scripts/reset-orders.js",
    "delete:account": "node scripts/delete-account.js",
    "seed:shop": "node scripts/seed-shop.js",
    "seed:demo": "node scripts/demo/seed-demo.js",
    "seed:pay": "node scripts/demo/seed-pay.js",
    "seed:request": "node scripts/demo/seed-request.js",
    "sim:driver": "node scripts/demo/simulate-driver.js",
    "seed:clean": "node scripts/demo/seed-clean.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.0"
  }
}
