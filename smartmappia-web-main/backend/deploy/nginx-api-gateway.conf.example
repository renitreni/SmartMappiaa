# Add these directives to the HTTPS `server` block for api.smartmappia.com.
# Keep the existing Certbot certificate/listen directives unchanged.

# API-owned uploads allow at most 10 MB. Nginx defaults to 1 MB, so leave
# enough room for the multipart envelope while Express enforces the real cap.
client_max_body_size 12m;

# Put this exact-match location before the existing `location /` block.
location = /api/events {
    proxy_pass http://127.0.0.1:4000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";

    proxy_buffering off;
    proxy_cache off;
    gzip off;
    proxy_read_timeout 75s;
    proxy_send_timeout 75s;
}
