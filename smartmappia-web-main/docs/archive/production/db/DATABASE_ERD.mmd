erDiagram
    AUTH_USERS ||--|| PROFILES : "1:1 (auth identity)"
    PROFILES ||--o{ BOOKINGS : "books (user_id)"
    PROFILES ||--o{ BOOKINGS : "drives (assigned_driver_id)"
    PROFILES ||--o{ PAYMENT_PROOFS : "uploads"
    PROFILES ||--o{ PAYMENT_PROOFS : "reviews (admin)"
    PROFILES ||--o{ PAYMENTS : "verifies (admin)"
    PROFILES ||--o{ TRACKING_EVENTS : "creates"
    PROFILES ||--o{ DRIVER_LOCATIONS : "pings"
    PROFILES ||--o{ LEDGER_ENTRIES : "earns (driver)"
    PROFILES ||--o{ DRIVER_DOCUMENTS : "submits"
    PROFILES ||--o{ DRIVER_DOCUMENTS : "reviews (admin)"
    PROFILES ||--o{ DEVICE_PUSH_TOKENS : "registers"
    PROFILES ||--o{ NOTIFICATION_EVENTS : "receives"

    BOOKINGS ||--o{ PAYMENT_PROOFS : "has"
    BOOKINGS ||--o{ PAYMENTS : "has"
    BOOKINGS ||--o{ TRACKING_EVENTS : "logs"
    BOOKINGS ||--o{ LEDGER_ENTRIES : "settles"
    BOOKINGS ||--o{ WEBHOOK_EVENTS : "referenced by"
    BOOKINGS ||--o{ NOTIFICATION_EVENTS : "triggers"

    %% ---- Food Delivery (migrations 0009-0015) ----
    PROFILES ||--o| MERCHANTS : "owns (owner_id, nullable)"
    PROFILES ||--o{ CARTS : "has"
    PROFILES ||--o{ ORDERS : "places (customer_id)"
    PROFILES ||--o{ DELIVERIES : "delivers (driver_id)"
    PROFILES ||--o{ DRIVER_RATINGS : "gives/receives"
    PROFILES ||--o{ DISPATCH_OFFERS : "offered to"
    PROFILES ||--o{ AUDIT_LOGS : "acts (actor_id)"
    MERCHANTS ||--o{ MENU_CATEGORIES : "has"
    MERCHANTS ||--o{ MENU_ITEMS : "has"
    MERCHANTS ||--o{ ORDERS : "receives"
    MERCHANTS ||--o{ MERCHANT_CREDIT_LEDGER : "ledger"
    MENU_CATEGORIES ||--o{ MENU_ITEMS : "groups"
    CARTS ||--o{ CART_ITEMS : "contains"
    MENU_ITEMS ||--o{ CART_ITEMS : "referenced by"
    ORDERS ||--o{ ORDER_ITEMS : "contains"
    MENU_ITEMS ||--o{ ORDER_ITEMS : "snapshotted by"
    ORDERS ||--o{ ORDER_PAYMENTS : "paid by"
    ORDERS ||--o| DELIVERIES : "fulfilled by"
    ORDERS ||--o{ MERCHANT_CREDIT_LEDGER : "charges"
    ORDERS ||--o| RATINGS : "rated by"
    ORDERS ||--o| DRIVER_RATINGS : "rates driver"
    ORDERS ||--o{ DISPATCH_OFFERS : "offered"
    ORDERS ||--o{ FD_ANALYTICS_EVENTS : "logged"
    BOOKINGS ||--o{ DISPATCH_OFFERS : "offered"
    BOOKINGS ||--o| DRIVER_RATINGS : "rates driver"

    PROFILES {
        uuid id PK "FK auth.users (cascade)"
        user_role role "default passenger; +merchant (0009)"
        text full_name
        text mobile_number
        text whatsapp_number
        text email
        boolean driver_approved "default false (0004 pilot NOT applied)"
        date date_of_birth
        text gender
        text national_id
        text vehicle_type
        text vehicle_plate
        driver_verification_status driver_verification_status "NEW default none"
        timestamptz created_at
        timestamptz updated_at
    }

    BOOKINGS {
        uuid id PK
        text booking_code UK "default gen_booking_code()"
        uuid user_id FK "profiles (set null)"
        trip_type trip_type "NOT NULL"
        order_type order_type "NEW default pick_drop"
        text airport_terminal
        text pickup_address
        double pickup_lat
        double pickup_lng
        text dropoff_address
        double dropoff_lat
        double dropoff_lng
        timestamptz pickup_datetime
        int passenger_count "default 1"
        int luggage_count "default 0"
        numeric fare_amount "NOT NULL"
        text currency "default SAR"
        payment_method payment_method
        payment_status payment_status
        booking_status booking_status
        verification_mode verification_mode
        uuid assigned_driver_id FK "profiles (set null)"
        driver_ride_status driver_ride_status
        timestamptz created_at
        timestamptz updated_at
    }

    PAYMENT_PROOFS {
        uuid id PK
        uuid booking_id FK "bookings (cascade)"
        uuid uploaded_by_user_id FK "profiles (set null)"
        text file_url "NOT NULL"
        text file_hash
        proof_status status "default uploaded"
        verification_mode verification_mode
        uuid admin_reviewer_id FK "profiles (set null)"
        timestamptz created_at
    }

    PAYMENTS {
        uuid id PK
        uuid booking_id FK "bookings (cascade)"
        payment_provider provider "default stcpay_manual"
        numeric amount "NOT NULL"
        text currency "default SAR"
        payment_status status
        uuid verified_by_admin_id FK "profiles (set null)"
        boolean verified_by_system
        text gateway_payment_id "NEW unique"
        jsonb gateway_raw "NEW"
        timestamptz created_at
    }

    TRACKING_EVENTS {
        uuid id PK
        uuid booking_id FK "bookings (cascade)"
        text event_type "NOT NULL"
        text title
        text message
        uuid created_by_user_id FK "profiles (set null)"
        timestamptz created_at
    }

    DRIVER_LOCATIONS {
        uuid id PK
        uuid driver_id FK "profiles (cascade)"
        double lat "NOT NULL"
        double lng "NOT NULL"
        double accuracy_meters
        timestamptz recorded_at
    }

    LEDGER_ENTRIES {
        uuid id PK
        uuid booking_id FK "bookings (cascade)"
        uuid driver_id FK "profiles (set null)"
        numeric gross_fare "NOT NULL"
        numeric platform_commission
        numeric driver_net
        numeric platform_net
        payout_status payout_status "default pending"
        timestamptz created_at
    }

    DRIVER_DOCUMENTS {
        uuid id PK "NEW"
        uuid driver_id FK "profiles (cascade)"
        driver_doc_type doc_type "NOT NULL"
        text storage_path "NOT NULL"
        text file_hash
        date expiry_date
        driver_doc_status status "default pending"
        uuid reviewed_by_admin_id FK "profiles (set null)"
        timestamptz created_at
    }

    WEBHOOK_EVENTS {
        uuid id PK "NEW"
        text provider
        text event_type
        text gateway_payment_id
        uuid booking_id FK "bookings (set null)"
        boolean signature_verified
        jsonb payload
        timestamptz created_at
    }

    DEVICE_PUSH_TOKENS {
        uuid id PK "NEW"
        uuid user_id FK "profiles (cascade)"
        text token "NOT NULL"
        text platform "android/ios/web"
        timestamptz last_seen_at
        timestamptz created_at
    }

    NOTIFICATION_EVENTS {
        uuid id PK "NEW"
        uuid user_id FK "profiles (set null)"
        uuid booking_id FK "bookings (set null)"
        text type
        text channel
        timestamptz sent_at
        timestamptz created_at
    }

    MERCHANTS {
        uuid id PK "0009"
        uuid owner_id FK "profiles (set null); nullable, unique"
        text name "NOT NULL"
        text cuisine_type
        text description
        text logo_url
        text address
        double lat
        double lng
        numeric service_radius_km "default 15"
        boolean is_active "default false (unlisted until vetted)"
        merchant_status status "default active"
        numeric credit_limit "default 300"
        numeric credit_used "default 0"
        boolean is_featured "NEW 0015 default false"
        text badge "NEW 0015 (top_rated/popular/new/trending)"
        timestamptz created_at
        timestamptz updated_at
    }

    MENU_CATEGORIES {
        uuid id PK "0009"
        uuid merchant_id FK "merchants (cascade)"
        text name "NOT NULL"
        int sort_order "default 0"
        boolean is_active "default true"
        timestamptz created_at
    }

    MENU_ITEMS {
        uuid id PK "0009"
        uuid merchant_id FK "merchants (cascade)"
        uuid category_id FK "menu_categories (set null)"
        text name "NOT NULL"
        text description
        numeric price "NOT NULL check > 0"
        item_type item_type "default meal_package"
        text image_url
        boolean is_available "default true"
        timestamptz created_at
        timestamptz updated_at
    }

    CARTS {
        uuid id PK "0010"
        uuid customer_id FK "profiles (cascade)"
        uuid merchant_id FK "merchants (cascade)"
        timestamptz created_at
        timestamptz updated_at
    }

    CART_ITEMS {
        uuid id PK "0010"
        uuid cart_id FK "carts (cascade)"
        uuid menu_item_id FK "menu_items (cascade)"
        int quantity "default 1 check > 0"
        numeric unit_price "display snapshot only"
        timestamptz created_at
    }

    ORDERS {
        uuid id PK "0010"
        text order_code UK "default gen_order_code() -> FD-XXXXXXXX"
        uuid customer_id FK "profiles (RESTRICT)"
        uuid merchant_id FK "merchants (RESTRICT)"
        order_status status "default pending"
        numeric subtotal "NOT NULL (food)"
        numeric delivery_fee "NOT NULL"
        numeric platform_margin_total "NOT NULL (our margin)"
        numeric total "NOT NULL (customer pays)"
        numeric distance_km
        text delivery_address "NOT NULL"
        double delivery_lat
        double delivery_lng
        fd_payment_status payment_status "default awaiting"
        fd_payment_method payment_method "default stcpay"
        text gateway_transaction_id "token/txn id only"
        text reject_reason
        timestamptz created_at
        timestamptz accepted_at
        timestamptz ready_at
        timestamptz delivered_at
    }

    ORDER_ITEMS {
        uuid id PK "0010 (immutable snapshot)"
        uuid order_id FK "orders (cascade)"
        uuid menu_item_id FK "menu_items (set null)"
        text name_snapshot "NOT NULL"
        numeric unit_price "NOT NULL"
        int quantity "check > 0"
        numeric line_total "NOT NULL"
        numeric margin_per_item "NOT NULL"
        numeric margin_total "NOT NULL"
    }

    ORDER_PAYMENTS {
        uuid id PK "0010"
        uuid order_id FK "orders (cascade)"
        fd_payment_method provider "NOT NULL"
        numeric amount "NOT NULL"
        fd_payment_status status "default awaiting"
        text gateway_transaction_id "UNIQUE partial (webhook idempotency)"
        jsonb gateway_raw "never card data"
        timestamptz created_at
    }

    DELIVERIES {
        uuid id PK "0010"
        uuid order_id FK "orders (cascade); UNIQUE (one per order)"
        uuid driver_id FK "profiles (set null)"
        numeric fee
        text status
        text pickup_photo_path "mandatory proof"
        text delivery_photo_path "mandatory proof"
        timestamptz picked_up_at
        timestamptz delivered_at
        timestamptz created_at
    }

    MERCHANT_CREDIT_LEDGER {
        uuid id PK "0011 (append-only)"
        uuid merchant_id FK "merchants (cascade)"
        uuid order_id FK "orders (set null)"
        credit_ledger_type type "NOT NULL"
        numeric amount "check >= 0"
        numeric balance_after "NOT NULL"
        text note
        uuid created_by FK "profiles (set null)"
        timestamptz created_at
    }

    RATINGS {
        uuid id PK "0012 (defined, not wired yet)"
        uuid order_id FK "orders (cascade); UNIQUE"
        uuid customer_id FK "profiles (cascade)"
        uuid merchant_id FK "merchants (cascade)"
        int food_rating "check 1-5"
        int speed_rating "check 1-5"
        text comment
        timestamptz created_at
    }

    PROMOCODES {
        uuid id PK "0012 (defined, not wired yet)"
        text code UK "NOT NULL"
        discount_type discount_type "NOT NULL"
        numeric value "check > 0"
        numeric min_order
        boolean active "default true"
        timestamptz starts_at
        timestamptz expires_at
        timestamptz created_at
    }

    FD_ANALYTICS_EVENTS {
        uuid id PK "0012"
        text event_name "NOT NULL"
        uuid user_id FK "profiles (set null)"
        uuid order_id FK "orders (set null)"
        uuid merchant_id FK "merchants (set null)"
        jsonb params
        timestamptz created_at
    }

    AUDIT_LOGS {
        uuid id PK "0012 (append-only, admin read)"
        uuid actor_id FK "profiles (set null)"
        text action "NOT NULL"
        text resource_type
        text resource_id
        jsonb meta "never secrets/card data"
        timestamptz created_at
    }

    DISPATCH_OFFERS {
        uuid id PK "0013 (Grab-style cascade)"
        uuid order_id FK "orders (cascade); nullable"
        uuid booking_id FK "bookings (cascade); nullable"
        uuid driver_id FK "profiles (cascade)"
        dispatch_offer_status status "default pending"
        int round "default 1"
        numeric distance_km
        timestamptz offered_at
        timestamptz expires_at "NOT NULL (30s window)"
        timestamptz responded_at
    }

    DRIVER_RATINGS {
        uuid id PK "0014 (food + P&D)"
        uuid driver_id FK "profiles (cascade)"
        uuid customer_id FK "profiles (set null)"
        uuid order_id FK "orders (cascade); UNIQUE"
        uuid booking_id FK "bookings (cascade); UNIQUE"
        int stars "NOT NULL check 1-5"
        text comment
        timestamptz created_at
    }
