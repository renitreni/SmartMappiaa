// =====================================================================
// Smart Mappia — ERD for dbdiagram.io (DBML)
// Generated from backend/migrations/0001..0022 (final consolidated state).
//
// USE: open https://dbdiagram.io -> New Diagram -> paste this whole file.
// It auto-draws all 27 tables + every relationship, color-coded by domain:
//   blue   = Identity & Drivers
//   green  = Rides (Pick & Drop) & shared
//   orange = Food Delivery
//
// This is a DIAGRAM SOURCE, not a migration. Enums are shown as text with
// their values in comments; profiles' FK to Supabase auth.users is omitted
// (that table lives in the auth schema, outside this diagram).
// =====================================================================

// ============================ IDENTITY & DRIVERS (blue) ==============

Table profiles [headercolor: #2563EB] {
  id uuid [pk]
  role text // passenger | driver | admin | merchant
  full_name text
  mobile_number text
  whatsapp_number text
  email text
  driver_approved boolean
  date_of_birth date
  gender text
  national_id text
  vehicle_type text
  vehicle_plate text
  driver_verification_status text // none | submitted | approved | rejected
  service_types text // text[] : pick_drop | food | shop
  cash_owed numeric
  cash_owed_limit numeric
  created_at timestamp
  updated_at timestamp
}

Table driver_documents [headercolor: #2563EB] {
  id uuid [pk]
  driver_id uuid
  doc_type text // national_id|license|vehicle_registration|insurance|tga_permit|profile_photo|vehicle_photo
  storage_path text
  file_name text
  mime_type text
  file_size_bytes bigint
  file_hash text
  expiry_date date
  status text // pending | verified | rejected
  rejection_reason text
  reviewed_by_admin_id uuid
  reviewed_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table driver_locations [headercolor: #2563EB] {
  id uuid [pk]
  driver_id uuid
  lat float
  lng float
  accuracy_meters float
  recorded_at timestamp
}

Table device_push_tokens [headercolor: #2563EB] {
  id uuid [pk]
  user_id uuid
  token text
  platform text // android | ios | web
  app_version text
  last_seen_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table driver_ratings [headercolor: #2563EB] {
  id uuid [pk]
  driver_id uuid
  customer_id uuid
  order_id uuid [unique]   // XOR booking_id
  booking_id uuid [unique] // XOR order_id
  stars int
  comment text
  created_at timestamp
}

Table driver_cash_ledger [headercolor: #2563EB] {
  id uuid [pk]
  driver_id uuid
  booking_id uuid
  type text // charge | settlement | adjustment
  amount numeric
  balance_after numeric
  note text
  created_by uuid
  created_at timestamp
}

// ======================= RIDES (Pick & Drop) & SHARED (green) ========

Table bookings [headercolor: #059669] {
  id uuid [pk]
  booking_code text [unique]
  user_id uuid // nullable: guest bookings
  trip_type text // house_to_airport | airport_to_house
  order_type text // pick_drop | food | shop | package
  airport_terminal text
  pickup_address text
  pickup_lat float
  pickup_lng float
  dropoff_address text
  dropoff_lat float
  dropoff_lng float
  pickup_datetime timestamp
  passenger_count int
  luggage_count int
  notes text
  passenger_name text
  passenger_mobile text
  passenger_whatsapp text
  passenger_email text
  fare_amount numeric
  currency text
  payment_method text // stcpay_manual | moyasar | tap | cash
  payment_status text
  booking_status text // pending_payment..completed | cancelled
  verification_mode text
  test_auto_verified_at timestamp
  confirmed_at timestamp
  assigned_driver_id uuid
  driver_ride_status text
  scheduled_pickup_eta_text text
  payment_confirmation_eta_text text
  driver_arrival_eta_minutes int
  passenger_snapshot_name text
  passenger_snapshot_whatsapp text
  passenger_snapshot_mobile text
  driver_snapshot_name text
  driver_snapshot_vehicle_type text
  driver_snapshot_vehicle_plate text
  driver_assigned_at timestamp
  actual_pickup_at timestamp
  actual_dropoff_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table payment_proofs [headercolor: #059669] {
  id uuid [pk]
  booking_id uuid
  uploaded_by_user_id uuid
  file_url text
  file_name text
  file_mime_type text
  file_size_bytes bigint
  file_hash text
  status text // uploaded | under_review | verified | rejected
  verification_mode text
  admin_reviewer_id uuid
  reviewed_at timestamp
  test_auto_verified_at timestamp
  rejection_reason text
  created_at timestamp
}

Table payments [headercolor: #059669] {
  id uuid [pk]
  booking_id uuid
  provider text // stcpay_manual | moyasar | tap | cash
  amount numeric
  currency text
  status text
  manual_reference text
  verified_by_admin_id uuid
  verified_by_system boolean
  verification_mode text
  verified_at timestamp
  notes text
  gateway_provider text
  gateway_payment_id text
  gateway_reference text
  gateway_status text
  gateway_raw jsonb
  created_at timestamp
}

Table tracking_events [headercolor: #059669] {
  id uuid [pk]
  booking_id uuid
  event_type text
  title text
  message text
  created_by_user_id uuid
  created_at timestamp
}

Table ledger_entries [headercolor: #059669] {
  id uuid [pk]
  booking_id uuid
  driver_id uuid
  gross_fare numeric
  platform_commission numeric
  manual_payment_fee numeric
  driver_gross numeric
  driver_net numeric
  platform_net numeric
  payout_status text // pending | simulated_test | paid | cancelled
  created_at timestamp
}

Table webhook_events [headercolor: #059669] {
  id uuid [pk]
  provider text
  event_type text
  gateway_payment_id text
  booking_id uuid
  signature_verified boolean
  payload jsonb
  processed_at timestamp
  created_at timestamp
}

Table dispatch_offers [headercolor: #059669] {
  id uuid [pk]
  order_id uuid   // XOR booking_id (food job)
  booking_id uuid // XOR order_id  (ride job)
  driver_id uuid
  status text // pending | accepted | declined | expired | cancelled
  round int
  distance_km numeric
  offered_at timestamp
  expires_at timestamp
  responded_at timestamp
}

Table notification_events [headercolor: #059669] {
  id uuid [pk]
  user_id uuid
  booking_id uuid
  order_id uuid
  type text
  channel text // push | in_app | sms
  code text
  sent_at timestamp
  read_at timestamp
  created_at timestamp
}

Table audit_logs [headercolor: #059669] {
  id uuid [pk]
  actor_id uuid
  action text
  resource_type text
  resource_id text
  meta jsonb
  created_at timestamp
}

// ========================= FOOD DELIVERY (orange) ====================

Table merchants [headercolor: #EA580C] {
  id uuid [pk]
  owner_id uuid [unique] // nullable
  name text
  cuisine_type text
  description text
  logo_url text
  address text
  lat float
  lng float
  service_radius_km numeric
  is_active boolean
  status text // active | suspended
  credit_limit numeric
  credit_used numeric
  is_featured boolean
  badge text // top_rated | popular | new | trending
  created_at timestamp
  updated_at timestamp
}

Table menu_categories [headercolor: #EA580C] {
  id uuid [pk]
  merchant_id uuid
  name text
  sort_order int
  is_active boolean
  created_at timestamp
}

Table menu_items [headercolor: #EA580C] {
  id uuid [pk]
  merchant_id uuid
  category_id uuid
  name text
  description text
  price numeric // list price shown to customer
  net_price numeric // what the restaurant keeps (nullable)
  item_type text // meal_package | drink_dessert_addon
  image_url text
  is_available boolean
  created_at timestamp
  updated_at timestamp
}

Table carts [headercolor: #EA580C] {
  id uuid [pk]
  customer_id uuid
  merchant_id uuid
  created_at timestamp
  updated_at timestamp
}

Table cart_items [headercolor: #EA580C] {
  id uuid [pk]
  cart_id uuid
  menu_item_id uuid
  quantity int
  unit_price numeric
  created_at timestamp
}

Table orders [headercolor: #EA580C] {
  id uuid [pk]
  order_code text [unique]
  customer_id uuid
  merchant_id uuid
  status text // pending..delivered | cancelled | rejected
  subtotal numeric
  delivery_fee numeric
  platform_margin_total numeric
  total numeric
  distance_km numeric
  delivery_address text
  delivery_lat float
  delivery_lng float
  payment_status text // awaiting | paid | failed | refunded
  payment_method text // stcpay | tap | cash
  gateway_transaction_id text
  reject_reason text
  created_at timestamp
  accepted_at timestamp
  ready_at timestamp
  delivered_at timestamp
}

Table order_items [headercolor: #EA580C] {
  id uuid [pk]
  order_id uuid
  menu_item_id uuid
  name_snapshot text
  unit_price numeric
  quantity int
  line_total numeric
  margin_per_item numeric
  margin_total numeric
}

Table order_payments [headercolor: #EA580C] {
  id uuid [pk]
  order_id uuid
  provider text // stcpay | tap | cash
  amount numeric
  status text // awaiting | paid | failed | refunded
  gateway_transaction_id text
  gateway_raw jsonb
  created_at timestamp
}

Table deliveries [headercolor: #EA580C] {
  id uuid [pk]
  order_id uuid [unique]
  driver_id uuid
  fee numeric
  status text // searching | open | assigned | picked_up | delivered
  pickup_photo_path text
  delivery_photo_path text
  picked_up_at timestamp
  delivered_at timestamp
  created_at timestamp
}

Table merchant_credit_ledger [headercolor: #EA580C] {
  id uuid [pk]
  merchant_id uuid
  order_id uuid
  type text // charge | replenish | adjustment
  amount numeric
  balance_after numeric
  note text
  created_by uuid
  created_at timestamp
}

Table ratings [headercolor: #EA580C] {
  id uuid [pk]
  order_id uuid [unique]
  customer_id uuid
  merchant_id uuid
  food_rating int
  speed_rating int
  comment text
  created_at timestamp
}

Table promocodes [headercolor: #EA580C] {
  id uuid [pk]
  code text [unique]
  discount_type text // percent | fixed
  value numeric
  min_order numeric
  active boolean
  starts_at timestamp
  expires_at timestamp
  created_at timestamp
}

Table fd_analytics_events [headercolor: #EA580C] {
  id uuid [pk]
  event_name text
  user_id uuid
  order_id uuid
  merchant_id uuid
  params jsonb
  created_at timestamp
}

// ============================ RELATIONSHIPS ==========================
// '>' = many-to-one (child -> parent).  '-' = one-to-one (unique FK).

// Identity & drivers
Ref: driver_documents.driver_id > profiles.id
Ref: driver_documents.reviewed_by_admin_id > profiles.id
Ref: driver_locations.driver_id > profiles.id
Ref: device_push_tokens.user_id > profiles.id
Ref: driver_ratings.driver_id > profiles.id
Ref: driver_ratings.customer_id > profiles.id
Ref: driver_ratings.order_id - orders.id
Ref: driver_ratings.booking_id - bookings.id
Ref: driver_cash_ledger.driver_id > profiles.id
Ref: driver_cash_ledger.booking_id > bookings.id
Ref: driver_cash_ledger.created_by > profiles.id

// Rides (Pick & Drop)
Ref: bookings.user_id > profiles.id
Ref: bookings.assigned_driver_id > profiles.id
Ref: payment_proofs.booking_id > bookings.id
Ref: payment_proofs.uploaded_by_user_id > profiles.id
Ref: payment_proofs.admin_reviewer_id > profiles.id
Ref: payments.booking_id > bookings.id
Ref: payments.verified_by_admin_id > profiles.id
Ref: tracking_events.booking_id > bookings.id
Ref: tracking_events.created_by_user_id > profiles.id
Ref: ledger_entries.booking_id > bookings.id
Ref: ledger_entries.driver_id > profiles.id
Ref: webhook_events.booking_id > bookings.id

// Shared dispatch / notifications / audit
Ref: dispatch_offers.order_id > orders.id
Ref: dispatch_offers.booking_id > bookings.id
Ref: dispatch_offers.driver_id > profiles.id
Ref: notification_events.user_id > profiles.id
Ref: notification_events.booking_id > bookings.id
Ref: notification_events.order_id > orders.id
Ref: audit_logs.actor_id > profiles.id

// Food delivery
Ref: merchants.owner_id - profiles.id
Ref: menu_categories.merchant_id > merchants.id
Ref: menu_items.merchant_id > merchants.id
Ref: menu_items.category_id > menu_categories.id
Ref: carts.customer_id > profiles.id
Ref: carts.merchant_id > merchants.id
Ref: cart_items.cart_id > carts.id
Ref: cart_items.menu_item_id > menu_items.id
Ref: orders.customer_id > profiles.id
Ref: orders.merchant_id > merchants.id
Ref: order_items.order_id > orders.id
Ref: order_items.menu_item_id > menu_items.id
Ref: order_payments.order_id > orders.id
Ref: deliveries.order_id - orders.id
Ref: deliveries.driver_id > profiles.id
Ref: merchant_credit_ledger.merchant_id > merchants.id
Ref: merchant_credit_ledger.order_id > orders.id
Ref: merchant_credit_ledger.created_by > profiles.id
Ref: ratings.order_id - orders.id
Ref: ratings.customer_id > profiles.id
Ref: ratings.merchant_id > merchants.id
Ref: fd_analytics_events.user_id > profiles.id
Ref: fd_analytics_events.order_id > orders.id
Ref: fd_analytics_events.merchant_id > merchants.id

// ============================ GROUPS =================================
TableGroup "Identity & Drivers" [color: #2563EB] {
  profiles
  driver_documents
  driver_locations
  device_push_tokens
  driver_ratings
  driver_cash_ledger
}

TableGroup "Rides & Shared" [color: #059669] {
  bookings
  payment_proofs
  payments
  tracking_events
  ledger_entries
  webhook_events
  dispatch_offers
  notification_events
  audit_logs
}

TableGroup "Food Delivery" [color: #EA580C] {
  merchants
  menu_categories
  menu_items
  carts
  cart_items
  orders
  order_items
  order_payments
  deliveries
  merchant_credit_ledger
  ratings
  promocodes
  fd_analytics_events
}
